    <script nonce="b1fd4b7f-fde9-4f2d-80cc-c29d95b19ac8">
            $(".google-mfa-setup").hide();
            const textFields = document.querySelectorAll('.mdc-text-field');
            for (const textField of textFields) {
                mdc.textField.MDCTextField.attachTo(textField);
            }

            const textFieldHelperTexts = document.querySelectorAll('.mdc-text-field-helper.text');
            for (const helperText of textFieldHelperTexts) {
                mdc.textFieldHelperText.MDCTextFieldHelperText.attachTo(helperText);
            }

            const icons = document.querySelectorAll('.mdc-text-field-icon');
            for (const icon of icons) {
                mdc.icon.MDCTextFieldIcon.attachTo(icon);
            }

            $("#btnLogIn").on("click", function () {
                $("#IsResendSMS").val(false);
            });

            $("#inputMFA").val("");

            $("#btnGoogleAuthenticator").on("click", function () {
                $("#MFAType").val("GoogleAuthenticator");
                $(".mfa-instructions").hide();
                $(".google-mfa-setup").show();
             });

            $("#btnBackToInstructions").on("click", function () {
                $("#MFAType").val("NotSet");
                $(".mfa-instructions").show();
                $(".google-mfa-setup").hide();
             })

            $("#btnSMSNone").on("click", function() {
                $("#MFAType").val("None");
                $("#loginForm").submit();
            });

            $("#btnSMSEmail").on("click", function() {
                $("#MFAType").val("Email");
                $("#loginForm").submit();
            });

            $("#btnSMSAuthenticator").on("click", function () {
                $("#MFAType").val("SMS");
                $("#loginForm").submit();
            });

            $("#btnSMSAutomation").on("click", function() {
                $("#MFAType").val("Automation");
                $("#loginForm").submit();
            });

            $("#btnResendSMS").on("click", function () {
                $("#IsResendSMS").val("true");
                $("#loginForm").submit();
            });

            var disableLogin = function (disable) {
                if (disable)
                    $("#btnLogIn").prop('disabled', true).css("opacity", .25);
                else
                    $("#btnLogIn").prop('disabled', false).css("opacity", 1);
            }

            var inp = $("#inputMFA");
            if (inp.length) {
                inp.on("keyup blur change", function () {
                    disableLogin(inp.val().length == 0);
                });
                disableLogin(true);
            }

            var imgManualCopy = document.getElementById('imgCopyManualKey');
            if (imgManualCopy) {
                imgManualCopy.addEventListener('click', function () {
                    var txtManualKey = document.getElementById('textManualKey');
                    var range = document.createRange();
                    range.selectNode(txtManualKey);
                    window.getSelection().removeAllRanges();
                    window.getSelection().addRange(range);
                    document.execCommand('copy');
                    window.getSelection().removeAllRanges();
                    imgManualCopy.src = "/images/copied.png";
                });
            }
    </script>


