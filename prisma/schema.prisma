generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  pteId                 String?   @unique
  email                 String    @unique
  username              String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                  String    @default("USER")
  isActive              Boolean   @default(true)
  avatarUrl             String?
  countryOfResidence    String?
  dateOfBirth           DateTime?
  birthDay              Int?
  birthMonth            Int?
  birthYear             Int?
  gender                String?
  cityOfBirth           String?
  countryOfBirth        String?
  countryOfCitizenship  String?
  streetAddress         String?
  city                  String?
  phoneCountryCode      String?
  primaryPhone          String?
  accommodationsNeeded  Boolean   @default(false)
  smsConsent            Boolean   @default(false)
  communicationConsent  Boolean   @default(false)
  researchConsent       Boolean   @default(false)
  parentalConsentForm   String?
  deliveredBy           String?
  inSimplifiedChinese   Boolean   @default(false)
  noGivenNames          Boolean   @default(false)
  noLastName            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // "PTE Academic", "PTE Core"
  type        String   // "Individual", "Package"
  description String?
  price       Float
  currency    String   @default("AU$")
  imageUrl    String?
  variants    Json?    // For storing options like "Versions available"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
